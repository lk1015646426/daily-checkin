# ===== acy7 (New API) 账号（单账号）=====
ACY7_USER=your_acy7_username
ACY7_PASS=your_acy7_password

# ===== WorkBuddy（手机号+验证码/微信扫码登录）=====
# CI 无法自动登录，需本机运行 scripts/capture_workbuddy_token.py 取登录态 cookies，
# 将输出的 JSON 整段填入以下 Secrets（每个账号一个）。
WB1_COOKIES=<capture脚本输出的cookies JSON>
WB2_COOKIES=<capture脚本输出的cookies JSON>

# ===== 通知：Telegram（推荐）=====
TG_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_chat_id

# ===== 通知：Server酱（二选一，不用可留空）=====
SERVERCHAN_KEY=
