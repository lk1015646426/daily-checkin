# ===== acy7 (New API) 账号（单账号）=====
ACY7_USER=your_acy7_username
ACY7_PASS=your_acy7_password

# ===== WorkBuddy（手机号+验证码/微信扫码登录）=====
# CI 无法自动登录，需从 WorkBuddy 桌面客户端提取 access token。
# 客户端登录后，token 存于：
#   %LOCALAPPDATA%\CodeBuddyExtension\Data\Public\auth\workbuddy-desktop.info
# 取其中 auth.accessToken 的值填入以下 Secrets（每个账号一个）。
# token 有效期约 1 年，过期需重新登录客户端提取。
WB1_TOKEN=<access_token_from_workbuddy_desktop_info>
WB2_TOKEN=<access_token_from_workbuddy_desktop_info>

# ===== TRAE（手机号+验证码登录桌面客户端）=====
# CI 无法自动登录，需从对应账号的 TRAE storage.json 提取 refresh token。
# storage.json 路径（TRAE SOLO CN）：
#   %APPDATA%\TRAE SOLO CN\User\globalStorage\storage.json
# 其中 iCubeAuthInfo://icube.cloudide 字段为加密 token（dGMFEAAA 前缀）。
# device_id 来自同一登录状态下的 telemetry.devDeviceId。
# 每个账号的 token 和 device_id 必须成对填写，不能交叉使用。

# TRAE 账号 1780293
TRAE1_TOKEN=<refresh_token_from_trae_account_1>
TRAE1_DEVICE_ID=<device_id_from_trae_account_1>

# TRAE 账号 1920293
TRAE2_TOKEN=<refresh_token_from_trae_account_2>
TRAE2_DEVICE_ID=<device_id_from_trae_account_2>

# ===== 通知：Telegram（推荐）=====
TG_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_chat_id

# ===== 通知：Server酱（二选一，不用可留空）=====
SERVERCHAN_KEY=
